# ==============================================================================
# PROD Environment Pipeline & ECS Variables Example
# Copy this file to terraform.tfvars and customize for your AWS Account
# ==============================================================================

aws_region            = "ap-southeast-1"

# Email address to receive SNS manual approval notifications for Terraform Apply and App Deploy
approval_email        = "your-email@example.com"

# GitHub CodeStar / CodeConnections connection ARN:
github_connection_arn = "arn:aws:codestar-connections:ap-southeast-1:<YOUR_ACCOUNT_ID>:connection/<YOUR_CONNECTION_ID>"

# Your GitHub repository in format: Owner/Repo (e.g. your-github-user/NT548)
github_repository     = "your-github-user/NT548"

# Initial baseline Docker image tag for ECS task definitions before first pipeline build:
# Once CodePipeline builds images, ECS task definitions update automatically via rolling deployment.
app_image_tag         = "latest"

# First deployment only: keep services at 0 until PROD images are built.
# After the first successful AppBuild/AppDeploy, change to 1 and apply again.
service_desired_count = 0
